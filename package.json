{
  "name": "catraki",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de triagem e registro de atendimentos — Catraki no Cloudflare Pages",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w packages/frontend",
    "dev:pages": "npm run dev:pages -w packages/frontend",
    "build": "npm run build -w packages/frontend",
    "lint": "npm run lint -w packages/frontend",
    "typecheck": "npm run typecheck -w packages/frontend",
    "test": "npm run test -w packages/frontend",
    "test:coverage": "npm run test:coverage -w packages/frontend",
    "prisma:generate": "npm run prisma:generate -w packages/frontend",
    "prisma:seed": "npm run prisma:seed -w packages/frontend"
  }
}
