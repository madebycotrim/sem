# =============================================================================
# SAÚDE EM MOVIMENTO — Variáveis de Ambiente
# =============================================================================
# ATENÇÃO: Este arquivo é um EXEMPLO. Copie para .env e preencha os valores.
# O arquivo .env real NUNCA deve ser versionado (vide .gitignore).
# Cada ambiente (dev/staging/production) deve ter seu próprio .env segregado.
# =============================================================================

# --- Ambiente ---
NODE_ENV=development
# Valores: development | staging | production

# --- Servidor ---
PORT=3333
HOST=0.0.0.0

# --- Banco de Dados (Prisma) ---
# Dev: SQLite local | Prod: PostgreSQL ou SQL Server
DATABASE_URL="file:./dev.db"
# Produção: "postgresql://user:password@host:5432/saude_movimento?schema=public"

# --- Autenticação (JWT) ---
# Segredo para assinatura dos tokens JWT — mínimo 64 caracteres aleatórios
JWT_SECRET="TROCAR_POR_SEGREDO_ALEATORIO_DE_64_CARACTERES_MINIMO"
# Tempo de expiração do token (ex: 8h para um turno de trabalho)
JWT_EXPIRATION="8h"

# --- Criptografia de PII (LGPD Art. 46 — Medidas de Segurança) ---
# KEK (Key Encryption Key) — chave mestra de 256 bits em hexadecimal (64 caracteres hex)
# Usada para cifrar as DEKs (Data Encryption Keys) por registro.
# NUNCA versionar. Em produção, migrar para KMS/Vault.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEK_HEX="TROCAR_POR_CHAVE_HEX_DE_64_CARACTERES"

# --- Sessão e Inatividade ---
# Timeout de inatividade em minutos (padrão: 10 min — notebooks compartilhados)
SESSION_INACTIVITY_TIMEOUT_MINUTES=10

# --- CORS ---
# Origens permitidas (separadas por vírgula)
CORS_ORIGINS="http://localhost:5173"

# --- Rate Limiting ---
# Máximo de requisições por janela de tempo (por IP)
RATE_LIMIT_MAX=100
# Janela de tempo em milissegundos (padrão: 1 minuto)
RATE_LIMIT_WINDOW_MS=60000

# --- Logging ---
# Nível de log: debug | info | warn | error
LOG_LEVEL="info"

# --- Retenção de Dados ---
# Retenção de AccessLog em dias (Marco Civil: mínimo 180 dias / 6 meses)
ACCESS_LOG_RETENTION_DAYS=180
# Retenção padrão de PII de pacientes em dias (LGPD — definido pelo projeto)
PATIENT_DATA_RETENTION_DAYS=365

# --- MFA (TOTP) — Obrigatório para ADMIN e DPO ---
# Nome do emissor exibido no app autenticador (ex: Google Authenticator)
MFA_ISSUER="SaudeEmMovimento"
