# Configurações do Ambiente — Catraki (sem.catraki.com.br)
NODE_ENV=production

# Segredos Criptográficos (definir no painel do Cloudflare Pages -> Settings -> Environment Variables)
# Gere uma chave com: openssl rand -hex 32
JWT_SECRET=substituir_por_chave_secreta_com_pelo_menos_64_caracteres_hexadecimais_aqui
KEK_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Controle de Sessão e CORS
SESSION_INACTIVITY_TIMEOUT_MINUTES=10
CORS_ORIGINS=http://localhost:5173,https://sem.catraki.com.br
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Retenção de Dados e Logs
LOG_LEVEL=info
ACCESS_LOG_RETENTION_DAYS=180
PATIENT_DATA_RETENTION_DAYS=365

# MFA
MFA_ISSUER=Catraki SEM

# Integração com Consulta de CPF (apicpf.com)
VITE_APICPF_KEY=13a72d9612fc70df4a1b481939dbd50f

# Autenticação Bootstrap (Super Admin)
ADMIN_BOOTSTRAP_EMAIL=[EMAIL_ADDRESS]
ADMIN_BOOTSTRAP_PASSWORD=sua_senha_forte_aqui
