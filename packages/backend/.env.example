# Backend — Variáveis de Ambiente
# Copie para .env e preencha. NUNCA versione o .env real.

NODE_ENV=development
PORT=3333
HOST=0.0.0.0
DATABASE_URL="file:./dev.db"

# JWT (mínimo 64 caracteres aleatórios)
JWT_SECRET="TROCAR_POR_SEGREDO_ALEATORIO_DE_64_CARACTERES_MINIMO"
JWT_EXPIRATION="8h"

# Criptografia PII (KEK — 64 hex chars = 256 bits)
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEK_HEX="TROCAR_POR_CHAVE_HEX_DE_64_CARACTERES"

# Sessão
SESSION_INACTIVITY_TIMEOUT_MINUTES=10

# CORS
CORS_ORIGINS="http://localhost:5173"

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Logging
LOG_LEVEL="info"

# Retenção
ACCESS_LOG_RETENTION_DAYS=180
PATIENT_DATA_RETENTION_DAYS=365

# MFA
MFA_ISSUER="SaudeEmMovimento"
