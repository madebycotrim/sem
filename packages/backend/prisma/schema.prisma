// =============================================================================
// SCHEMA PRISMA — SAÚDE EM MOVIMENTO
// =============================================================================
// Schema 100% neutro (sem decorators nativos como @db.Uuid).
// Usa @id @default(uuid()) e tipos primitivos para portabilidade
// transparente SQLite → PostgreSQL → SQL Server.
//
// NOTA SOBRE AuditLog:
// - Em DEV (SQLite): imutabilidade garantida por convenção no Prisma Client
//   (nenhum método update/delete exposto para AuditLog).
// - Em PROD (PostgreSQL): aplicar migration SQL:
//   REVOKE UPDATE, DELETE ON audit_log FROM app_user;
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Usuário do Sistema ──────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  senhaHash     String
  nomeCompleto  String
  perfil        String   // ADMIN | TRIAGEM_RECEPCAO | PROFISSIONAL_SAUDE | DPO
  mfaSecret     String?  // Segredo TOTP (Base32) — criptografado em produção
  mfaAtivo      Boolean  @default(false)
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  atendimentos   AttendanceRecord[]
  accessLogs     AccessLog[]
  auditLogs      AuditLog[]

  @@map("users")
}

// ─── Escola / Local de Atendimento ───────────────────────────────────────────

model SchoolLocation {
  id        String   @id @default(uuid())
  nome      String
  endereco  String
  cidade    String
  uf        String
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  pacientes     Patient[]
  atendimentos  AttendanceRecord[]

  @@map("school_locations")
}

// ─── Paciente ────────────────────────────────────────────────────────────────
// Campos PII criptografados via AES-256-GCM com envelope encryption.
// DEK por registro, cifrada pela KEK (variável de ambiente).
//
// Finalidade: triagem e registro de atendimentos de saúde em escolas públicas.
// Base legal: consentimento do responsável legal (LGPD Art. 14).

model Patient {
  id                  String    @id @default(uuid())

  // --- Campos PII criptografados (AES-256-GCM) ---
  nomeEnc             String    // Nome completo cifrado
  cpfEnc              String    // CPF cifrado
  dataNascimentoEnc   String    // Data de nascimento cifrada
  telefoneEnc         String?   // Telefone cifrado (opcional)

  // --- Metadados de criptografia (envelope encryption) ---
  dekCifrada          String    // DEK cifrada pela KEK (hex)
  ivPii               String    // IV usado na cifração (hex)
  tagPii              String    // Authentication tag (hex)

  // --- Dados não sensíveis ---
  turma               String
  escolaLocalId       String
  escolaLocal         SchoolLocation @relation(fields: [escolaLocalId], references: [id])

  // --- LGPD: Retenção e expurgo ---
  retentionExpiresAt  DateTime?

  criadoEm            DateTime  @default(now())
  atualizadoEm        DateTime  @updatedAt

  consentimentos  Consent[]
  atendimentos    AttendanceRecord[]

  @@map("patients")
}

// ─── Consentimento (LGPD Art. 14) ────────────────────────────────────────────
// Registro do consentimento do responsável legal para tratamento
// de dados sensíveis de saúde de menor de idade.

model Consent {
  id                      String    @id @default(uuid())
  pacienteId              String
  paciente                Patient   @relation(fields: [pacienteId], references: [id])

  consentidoPor           String?   // Nome do responsável legal
  dataConsentimento       DateTime?
  referenciaDocumento     String?   // Protocolo / nº TCLE

  consentimentoDispensado Boolean   @default(false)
  justificativaDispensa   String?   // Hipótese legal (Art. 11, II, f)

  criadoEm                DateTime  @default(now())

  @@map("consents")
}

// ─── Registro de Atendimento ─────────────────────────────────────────────────

model AttendanceRecord {
  id                    String   @id @default(uuid())

  pacienteId            String
  paciente              Patient  @relation(fields: [pacienteId], references: [id])

  escolaLocalId         String
  escolaLocal           SchoolLocation @relation(fields: [escolaLocalId], references: [id])

  userId                String
  usuario               User     @relation(fields: [userId], references: [id])

  especialidade         String   // Enum via Zod: OFTALMOLOGIA | AUDIOMETRIA | etc.
  turno                 String   // MANHA | TARDE
  resumo                String
  procedimentos         String?
  insumosUtilizados     String?
  encaminhamentoExterno String?

  // Idempotência: UUID gerado no client, constraint UNIQUE
  idempotencyKey        String   @unique

  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  @@map("attendance_records")
}

// ─── Log de Acesso — Marco Civil da Internet (Lei 12.965/2014) ───────────────
// Retenção mínima: 6 meses.

model AccessLog {
  id                  String    @id @default(uuid())
  userId              String?
  usuario             User?     @relation(fields: [userId], references: [id])
  ip                  String
  metodo              String    // GET | POST | PUT | DELETE | PATCH
  rota                String
  requestId           String
  statusCode          Int?
  timestamp           DateTime  @default(now())
  retentionExpiresAt  DateTime  // now() + 6 meses (calculado no middleware)

  @@map("access_logs")
}

// ─── Log de Auditoria — LGPD (Art. 37, 38) ──────────────────────────────────
// IMUTÁVEL: sem UPDATE/DELETE pelo usuário de aplicação.
// - DEV (SQLite): imutabilidade por convenção (Prisma Client não expõe update/delete)
// - PROD (PostgreSQL): REVOKE UPDATE, DELETE ON audit_logs FROM app_user;

model AuditLog {
  id              String   @id @default(uuid())
  userId          String
  usuario         User     @relation(fields: [userId], references: [id])
  acao            String   // CREATE | UPDATE | DELETE | LOGIN | LOGOUT | EXPORT | etc.
  entidade        String   // Nome do modelo afetado
  entidadeId      String?  // ID do registro afetado
  diffAnterior    String?  // JSON do estado anterior (se UPDATE/DELETE)
  diffPosterior   String?  // JSON do estado posterior (se CREATE/UPDATE)
  ip              String
  timestamp       DateTime @default(now())

  @@map("audit_logs")
}
