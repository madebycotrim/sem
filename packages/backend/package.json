{
  "name": "@sistema/backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST do sistema Saúde em Movimento — Fastify + Prisma + AES-256-GCM",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@sistema/shared": "*",
    "fastify": "^5.12.0",
    "@fastify/cookie": "^11.1.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.0",
    "@fastify/swagger-ui": "^6.1.0",
    "@fastify/jwt": "^10.2.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.0",
    "otpauth": "^9.5.0"
  },
  "devDependencies": {
    "prisma": "^7.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "eslint": "^9.0.0",
    "@types/node": "^22.0.0"
  }
}
